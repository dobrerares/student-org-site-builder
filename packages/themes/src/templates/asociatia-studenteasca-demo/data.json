        {
          "id": "blk_about_faq",
          "type": "faq",
          "version": 1,
          "data": {
            "headline": "Întrebări frecvente",
            "items": [
              {
                "question": "Cine se poate înscrie în asociație?",
                "answer": "Orice student al universității, indiferent de specializare sau an de studiu, poate deveni membru al asociației."
              },
              {
                "question": "Există o cotizație?",
                "answer": "Cotizația este simbolică și acoperă consumabile de bază pentru ateliere. Detaliile se discută la prima întâlnire de orientare."
              },
              {
                "question": "Cât timp trebuie să dedic săptămânal?",
                "answer": "Implicarea este flexibilă: în medie, 2–4 ore pe săptămână pentru membri activi. Participarea la evenimente este opțională."
              },
              {
                "question": "Pot propune un proiect nou?",
                "answer": "Da. În fiecare semestru organizăm o sesiune deschisă în care orice membru poate propune un proiect; proiectele alese primesc sprijin organizatoric și buget."
              },
              {
                "question": "Cum vă pot contacta?",
                "answer": "Trimiteți-ne un mesaj la adresa de e-mail din pagina de contact sau scrieți-ne pe rețelele sociale. Răspundem în maximum 48 de ore în zilele lucrătoare."
              }
            ]
          }
        },
