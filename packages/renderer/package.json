{
  "name": "@sosb/renderer",
  "version": "0.0.0",
  "private": true,
  "description": "Pure function from (siteData, themeId) to HTML. Same code in browser preview and Node build.",
  "license": "MIT",
  "type": "module",
  "main": "./src/index.tsx",
  "types": "./src/index.tsx",
  "exports": {
    ".": {
      "types": "./src/index.tsx",
      "default": "./src/index.tsx"
    },
    "./internal/sanitize": {
      "browser": "./src/sanitize.ts",
      "node": "./src/sanitize.node.ts",
      "default": "./src/sanitize.node.ts"
    }
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.test.json",
    "build": "tsc --build"
  },
  "dependencies": {
    "@sosb/schema": "workspace:*",
    "dompurify": "^3.4.2",
    "preact": "^10.29.1",
    "preact-render-to-string": "^6.6.7"
  },
  "devDependencies": {
    "@types/jsdom": "^21.1.7",
    "axe-core": "^4.11.4",
    "esbuild": "^0.24.0",
    "jsdom": "^25.0.1"
  }
}
