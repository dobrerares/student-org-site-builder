{
  "name": "@sosb/ui",
  "version": "0.0.0",
  "private": true,
  "description": "Shared builder UI: shadcn-style React components on Base UI primitives, plus the builder stylesheet. Builder-only — never part of public site output.",
  "license": "MIT",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./styles.css": "./src/styles/builder.generated.css",
    "./css": {
      "types": "./src/styles/builder-css.generated.ts",
      "default": "./src/styles/builder-css.generated.ts"
    }
  },
  "scripts": {
    "build:css": "node ./scripts/build-css.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.test.json",
    "build": "tsc --build"
  },
  "dependencies": {
    "@base-ui-components/react": "1.0.0-rc.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tailwind-merge": "3.7.0"
  },
  "devDependencies": {
    "@tailwindcss/cli": "4.3.3",
    "@testing-library/dom": "10.4.1",
    "@testing-library/react": "16.3.3",
    "@types/jsdom": "^21.1.7",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "jsdom": "^25.0.1",
    "tailwindcss": "4.3.3"
  }
}
