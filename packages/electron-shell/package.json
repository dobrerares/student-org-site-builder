{
  "name": "@sosb/electron-shell",
  "version": "0.0.0",
  "private": true,
  "description": "Main process, IPC bridge to native dialogs, contextBridge preload, cross-platform packaging via electron-builder.",
  "license": "MIT",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./main": "./src/main.ts",
    "./preload": "./src/preload.ts",
    "./ipc": "./src/ipc-channels.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.test.json",
    "build": "tsc --build"
  },
  "dependencies": {
    "@sosb/assets": "workspace:*",
    "@sosb/editor-app": "workspace:*",
    "@sosb/schema": "workspace:*",
    "@sosb/vfs": "workspace:*",
    "electron-updater": "^6.6.2"
  },
  "devDependencies": {
    "electron": "^41.5.0",
    "electron-builder": "^26.0.0"
  }
}
