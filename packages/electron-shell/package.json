{
  "name": "@sosb/electron-shell",
  "version": "0.0.0",
  "private": true,
  "description": "Main process, IPC bridge to native dialogs, contextBridge preload, cross-platform packaging via electron-builder.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./main": {
      "types": "./dist/main.d.ts",
      "default": "./dist/main.js"
    },
    "./preload": {
      "types": "./dist/preload.d.ts",
      "default": "./dist/preload.js"
    },
    "./ipc": {
      "types": "./dist/ipc-channels.d.ts",
      "default": "./dist/ipc-channels.js"
    }
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.test.json",
    "build": "tsc --build"
  },
  "dependencies": {
    "@sosb/assets": "workspace:*",
    "@sosb/editor-app": "workspace:*",
    "@sosb/schema": "workspace:*",
    "@sosb/vfs": "workspace:*",
    "electron-updater": "^6.6.2"
  },
  "devDependencies": {
    "electron": "^41.5.0",
    "electron-builder": "^26.0.0"
  }
}
