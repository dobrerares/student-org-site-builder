{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "resolveJsonModule": true,
    "jsx": "react-jsx",
    "jsxImportSource": "react",
    "lib": ["ES2022", "DOM", "DOM.Iterable", "WebWorker"],
    "types": ["node", "jsdom"]
  },
  "include": ["src/**/*", "test/**/*", "scripts/**/*"],
  "exclude": ["dist", "node_modules"]
}
