{
  "name": "@sosb/browser-shell",
  "version": "0.0.0",
  "private": true,
  "description": "Service worker, single-file archival build, persistent VFS — host shell for the browser editor.",
  "license": "MIT",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.test.json",
    "build": "tsc --build",
    "build:archival": "node ./scripts/build-archival.mjs"
  },
  "dependencies": {
    "@sosb/build": "workspace:*",
    "@sosb/editor-app": "workspace:*",
    "@sosb/editor-state": "workspace:*",
    "@sosb/renderer": "workspace:*",
    "@sosb/schema": "workspace:*",
    "@sosb/themes": "workspace:*",
    "@sosb/vfs": "workspace:*",
    "@sosb/wizard": "workspace:*",
    "@sosb/zip": "workspace:*",
    "preact": "^10.29.1"
  },
  "devDependencies": {
    "@types/jsdom": "^21.1.7",
    "esbuild": "^0.24.0",
    "fake-indexeddb": "^6.0.0",
    "jsdom": "^25.0.1"
  }
}
