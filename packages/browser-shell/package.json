{
  "name": "@sosb/browser-shell",
  "version": "0.0.0",
  "private": true,
  "description": "Service worker, single-file archival build, persistent VFS — host shell for the browser editor.",
  "license": "MIT",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc --noEmit -p tsconfig.test.json",
    "build": "tsc --build",
    "build:archival": "node ./scripts/build-archival.mjs"
  },
  "dependencies": {
    "@sosb/build": "workspace:*",
    "@sosb/editor-app": "workspace:*",
    "@sosb/editor-state": "workspace:*",
    "@sosb/renderer": "workspace:*",
    "@sosb/schema": "workspace:*",
    "@sosb/themes": "workspace:*",
    "@sosb/ui": "workspace:*",
    "@sosb/vfs": "workspace:*",
    "@sosb/wizard": "workspace:*",
    "@sosb/zip": "workspace:*",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@testing-library/dom": "10.4.1",
    "@testing-library/react": "16.3.3",
    "@types/jsdom": "^21.1.7",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "esbuild": "^0.24.0",
    "fake-indexeddb": "^6.0.0",
    "jsdom": "^25.0.1",
    "vite": "6.0.5"
  }
}
