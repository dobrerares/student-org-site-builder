  "variants": {
    "hero": [
      {
        "id": "spotlight",
        "label": "Spotlight",
        "description": "Full-height hero with a radial glow behind the title."
      },
      {
        "id": "split",
        "label": "Split",
        "description": "Title and image side by side from the medium breakpoint up."
      }
    ],
    "valueList": [
      {
        "id": "cards",
        "label": "Cards",
        "description": "Bordered cards on the deep ground."
      },
      {
        "id": "plain",
        "label": "Plain",
        "description": "Borderless rows with a gold rule between them."
      }
    ],
    "teamGrid": [
      {
        "id": "portrait",
        "label": "Portraits",
        "description": "Tall portraits with names beneath."
      },
      {
        "id": "roster",
        "label": "Roster",
        "description": "Compact rows with small round photos."
      }
    ],
    "activitiesList": [
      {
        "id": "cards",
        "label": "Cards",
        "description": "Equal-height project cards."
      },
      {
        "id": "feature",
        "label": "Feature",
        "description": "Alternating wide image/text bands."
      }
    ],
    "partnerLogos": [
      {
        "id": "grid",
        "label": "Grid",
        "description": "Even grid of framed logos."
      },
      {
        "id": "band",
        "label": "Band",
        "description": "Single quiet row on a lighter panel."
      }
    ],
    "ctaBanner": [
      {
        "id": "gold",
        "label": "Gold",
        "description": "Solid gold panel with dark text."
      },
      {
        "id": "outline",
        "label": "Outline",
        "description": "Transparent panel with a gold border."
      }
    ]
  },
  "shellVariants": [
    {
      "id": "standard",
      "label": "Standard",
      "description": "Roomy header with the wordmark on the left."
    },
    {
      "id": "compact",
      "label": "Compact",
      "description": "Tighter sticky header for content-heavy sites."
    }
