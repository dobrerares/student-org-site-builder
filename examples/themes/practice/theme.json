    "--color-bg": "#0a0c39",
    "--color-muted": "#a7abd0",
    "--color-on-image": "#ffffff",
    "--font-headline": "\"Practice Display\", system-ui, sans-serif",
    "--font-body": "\"Practice Text\", system-ui, sans-serif",
    "--radius-base": "0px",
    "--measure-body": "68ch"
